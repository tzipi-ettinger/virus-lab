# Copy to .env and fill in real values. Never commit .env.
# One key per Google project, comma-separated, no quotes. The free-tier quota is
# per project: when one key's daily quota runs out, the next key is used.
GEMINI_API_KEYS=key-from-project-1,key-from-project-2
GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGIN=http://localhost:5173
# Postgres from `docker compose up -d db` (repo root). 127.0.0.1, not localhost:
# on Windows localhost tries IPv6 first and waits for a timeout.
# The live server uses Render's internal database URL instead.
DATABASE_URL=postgresql://virus_lab:virus_lab@127.0.0.1:5432/virus_lab

# fake = fixtures only, no key and no quota (for development and tests)
# gemini = real extraction with GEMINI_API_KEYS (the live server)
EXTRACTION_PROVIDER=fake
# Seconds for one model call (SPEC 9.7)
PROVIDER_TIMEOUT_S=60
# Dev only, sample files only: a page Gemini already read (same model and prompt)
# is answered from backend/.cache/ (gitignored) instead of a new call. Saves quota
# when running the measurement again. Never true on the live server.
EXTRACTION_CACHE=false
# Upload limits (SPEC 9.7). The whole request is held in memory, never on disk.
MAX_FILE_MB=20
MAX_PAGES_PER_REQUEST=60
MAX_REQUEST_MB=60
MAX_FILES_PER_REQUEST=20
# Pages read at once (= model calls at a time)
MAX_CONCURRENCY=4
