# Copy to .env and fill in real values. Never commit .env.
# One key per Google project, comma-separated, no quotes. The free-tier quota is
# per project: when one key's daily quota runs out, the next key is used.
GEMINI_API_KEYS=key-from-project-1,key-from-project-2
GEMINI_MODEL=gemini-3.8-flash
FRONTEND_ORIGIN=http://localhost:5173

# fake = fixtures only, no key and no quota (for development and tests)
# gemini = real extraction with GEMINI_API_KEYS (the live server)
EXTRACTION_PROVIDER=fake
# Seconds for one model call (SPEC 9.7)
PROVIDER_TIMEOUT_S=60
# Upload limits (SPEC 9.7). The whole request is held in memory, never on disk.
MAX_FILE_MB=20
MAX_PAGES_PER_REQUEST=60
MAX_REQUEST_MB=60
MAX_FILES_PER_REQUEST=20
# Pages read at once (= model calls at a time)
MAX_CONCURRENCY=4
