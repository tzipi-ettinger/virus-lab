                }
              }
            }
          },
          "401": {
            "description": "No valid session (\"unauthenticated\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Patch Record",
        "description": "Correct or confirm fields, rerun apply_rules (SPEC 7.4) and save.\n\nApproved records are read-only (A6).",
        "operationId": "patch_record_api_v1_records__record_id__patch",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordPatchResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session (\"unauthenticated\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Stale version (type \"version_conflict\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{record_id}/approve": {
      "post": {
        "summary": "Approve Record",
        "description": "Rerun the rules; approve only if no field still needs review (D3).",
        "operationId": "approve_record_api_v1_records__record_id__approve_post",
        "parameters": [
          {
            "name": "record_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Record Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                }
              }
            }
          },
          "401": {
            "description": "No valid session (\"unauthenticated\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Stale version (\"version_conflict\"), or fields still flagged (\"review_required\", listed in blocking_fields)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pages/{page_id}/image": {
      "get": {
        "summary": "Page Image",
        "description": "The rotated, compressed page the fields came from (D4). Sent with Cache-Control: no-store.",
        "operationId": "page_image_api_v1_pages__page_id__image_get",
        "parameters": [
          {
            "name": "page_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Page Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/jpeg": {}
            }
          },
          "401": {
            "description": "No valid session (\"unauthenticated\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such page (\"page_not_found\")",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "ApproveRequest"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "EXTRACTION_FAILED",
              "INVALID_FILE",
              "QUOTA_EXHAUSTED"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "ExtractResponse": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileResult"
            },
            "type": "array",
            "title": "Files"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/Record"
            },
            "type": "array",
            "title": "Records",
            "description": "Saved as pending."
          },
          "failed_pages": {
            "items": {
              "$ref": "#/components/schemas/FailedPage"
            },
            "type": "array",
            "title": "Failed Pages"
          },
          "quota_exhausted": {
            "type": "boolean",
            "title": "Quota Exhausted",
            "description": "The daily quota ran out after some pages were saved: stop sending files. The unread pages are in failed_pages with QUOTA_EXHAUSTED. When nothing was saved, extract answers 503 quota_exhausted instead.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "files",
          "records",
          "failed_pages"
        ],
        "title": "ExtractResponse"
      },
      "FailedPage": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id"
          },
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "page_number": {
            "type": "integer",
            "title": "Page Number"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "source_file",
          "page_number",
          "error"
        ],
        "title": "FailedPage",
        "description": "A page whose extraction failed. It is not saved (A7) and is shown as failed (FR-12)."
      },
      "FieldEdit": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "confirmed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed"
          }
        },
        "type": "object",
        "title": "FieldEdit",
        "description": "Leave a key out to keep it. value: null clears the field.\n\nSending a value unsets confirmed (SPEC 7.4)."
      },
      "FileResult": {
        "properties": {
          "file_id": {
            "type": "string",
            "title": "File Id",
            "description": "Generated by the server."
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "The original name."
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "filename",
          "page_count",
          "status",
          "error"
        ],
        "title": "FileResult"
      },
      "FormField": {
        "properties": {
          "raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "model_status": {
            "type": "string",
            "enum": [
              "found",
              "unclear",
              "not_found"
            ],
            "title": "Model Status"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Issues"
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review"
          },
          "corrected": {
            "type": "boolean",
            "title": "Corrected"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          }
        },
        "type": "object",
        "required": [
          "raw",
          "value",
          "model_status",
          "evidence",
          "issues",
          "needs_review",
          "corrected",
          "confirmed"
        ],
        "title": "FormField",
        "description": "One field, or one item of a list (central numbers, commitment numbers)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Issue": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FIELD_UNCLEAR",
              "REQUIRED_MISSING",
              "ID_CHECKSUM_INVALID",
              "ID_LENGTH_INVALID",
              "ID_NORMALIZED",
              "ID_PADDED",
              "DATE_INVALID",
              "DATE_OUT_OF_RANGE",
              "SENDER_UNKNOWN",
              "CENTRAL_FORMAT",
              "COMMITMENT_PREFIX",
              "COMMITMENT_PREFIX_REMOVED",
              "ROTATION_UNRESOLVED",
              "DUPLICATE_REMOVED",
              "DUPLICATE_RECORD",
              "PAGE_GROUPING_UNCERTAIN",
              "EXTRACTION_FAILED",
              "INVALID_FILE"
            ],
            "title": "Code"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
